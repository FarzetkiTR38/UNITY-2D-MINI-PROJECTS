{
  "voices": [
    {
      "text": "Düşmanlar ilerliyor.",
      "start": 0.1,
      "end": 1.41,
      "sha256": "a3ee09db36941b04b118fbf2ee4a2199cd1d83a823fbf0feab51924478d82b22"
    },
    {
      "text": "Ama panik yok.",
      "start": 1.65,
      "end": 2.52,
      "sha256": "e7a22522862e2e2fbcffcac6e6d404c6ddfc1d3e22c16d365484719a0a8717a3"
    },
    {
      "text": "Önce dondur.",
      "start": 2.7,
      "end": 3.58,
      "sha256": "bbd52ed85a17d70c7f63ebce5af4c5fa59399c51b2519973fb372a4d28f1ac74"
    },
    {
      "text": "Şimdi okları sırayla gönder.",
      "start": 4.25,
      "end": 5.92,
      "sha256": "a90378f0cd620129ea9a7cde20dbdce64b3429073ad0f27f11770fe3050f6b27"
    },
    {
      "text": "Son ok... Gökkuşağı!",
      "start": 8.53,
      "end": 10.29,
      "sha256": "5630787a8820365d5bfac85a810a42ba2df5c716255bb0a34f4f64964ffb1290"
    },
    {
      "text": "Hepsi temizlendi!",
      "start": 12.922222222222222,
      "end": 14.132229166666667,
      "sha256": "7ad01037eddb0ca54c487f1d1aef14b61f5d7b807351d9a0a631ff5ba5163e57"
    },
    {
      "text": "Oynamak için Play Store’dan indirin!",
